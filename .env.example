# ── Database ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_NAME=expense_manager
DB_USER=your_db_user
DB_PASS=your_db_password

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=production          # production | development
APP_TIMEZONE=Asia/Dubai
# Used to build password-reset links. Include the sub-folder if the app lives in one,
# e.g. https://yourdomain.com/expenses
APP_URL=https://yourdomain.com
APP_VERSION=1.0.0           # Increment to bust CSS/JS cache

# ── Email ────────────────────────────────────────────────────────────────────
MAIL_FROM=noreply@yourdomain.com
MAIL_FROM_NAME=ExpenseMngr

# ── Cron security ────────────────────────────────────────────────────────────
# Random secret to protect cron endpoints if triggered via HTTP (not CLI)
CRON_SECRET=change_me_to_a_long_random_string

# ── Lean Technologies (UAE Open Banking) ─────────────────────────────────────
# Sign up at https://dev.leantech.me to get your app token
# Set LEAN_ENV=production when going live
# Open banking is disabled until LEAN_CLIENT_ID and LEAN_CLIENT_SECRET are set.
LEAN_CLIENT_ID=
LEAN_CLIENT_SECRET=
# Link SDK app token (defaults to LEAN_CLIENT_ID when empty)
LEAN_APP_TOKEN=
# sandbox | production
LEAN_ENV=sandbox
# Webhook signing secret from the Lean dashboard (webhooks are rejected without it)
LEAN_WEBHOOK_SECRET=
# Optional API host override, e.g. https://api2.leantech.me
LEAN_API_BASE=

# ── Zakath metal prices (optional) ───────────────────────────────────────────
# gold-api (default, keyless) | metalpriceapi | none (manual prices only)
ZAKATH_METALS_PROVIDER=gold-api
# Only needed for metalpriceapi
ZAKATH_METALS_API_KEY=
